# Shraman Seva Group build/dev mode (vite --mode ssg). Non-secret.
# Deployment values (VITE_SITE_URL, VITE_CONTACT_WHATSAPP, ...) belong in the SSG Netlify site env, or in .env.ssg.local for local use.
VITE_BRAND=ssg

# Shraman Seva Group OneSignal app (public id, also visible in the shipped app). Its REST API key is secret and
# lives only in the vSeva Netlify site as ONESIGNAL_API_KEY_SSG (send-push runs there for every brand).
VITE_ONESIGNAL_APP_ID=f95c3c84-cc93-40f2-8d45-b8da1924342f
