<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:name=".VSevaApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Accent color OneSignal tints the notification small icon with on
             Android 5.0-7.1 (where the platform draws icon + text in this
             color) — matches saffron-600, the app's brand color. -->
        <meta-data android:name="com.onesignal.NotificationAccentColor" android:value="FFDE6B38" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ (API 33+) requires this to be declared and requested at
         runtime before any notification (including OneSignal push) is shown.
         requestPermission() is already called from services/oneSignalService.ts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foreground-only location. The app's geolocation calls (SOS best-effort
         position in services/sosService.ts, nearby-temple search) run in the
         Capacitor WebView, and Capacitor's WebChromeClient can only request
         the Android runtime permission for geolocation if it is declared here —
         without these two lines every native geolocation request was silently
         denied. No background-location permission is requested or needed. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Only Android 9 and older need this to save a shared card into the Gallery (Pictures/<app>);
         Android 10+ saves there without any permission (AppSharePlugin.saveToGallery). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Android 11+ package visibility: lets AppSharePlugin check for and open WhatsApp / Instagram
         directly ("Share to WhatsApp", "Instagram Story"). -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="com.instagram.android" />
        <intent>
            <action android:name="com.instagram.share.ADD_TO_STORY" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>
</manifest>
